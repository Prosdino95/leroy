    {
      "parameters": {
        "jsCode": "const base = $('Normalizza').first().json;\nconst estratto = $json.text || '';\n\n// Se il PDF e' scansionato non ha testo estraibile: lo segnalo invece di\n// fingere che la mail fosse vuota.\nconst scansione = estratto.replace(/\\s/g, '').length < 50;\n\nreturn [{ json: {\n  ...base,\n  testo: (base.testo + ' \\n--- allegato ---\\n ' + estratto)\n    .replace(/\\s+/g, ' ').trim().slice(0, 6000),\n  allegato_illeggibile: scansione,\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        -304
      ],
      "id": "e9cb2f61-184d-4b07-8b2c-bdd7571d1c8d",
      "name": "unisci allegato"
    },
    {
      "parameters": {
        "jsCode": "const m = $json;\n\nfunction b64(s) {\n  if (!s) return '';\n  try {\n    return Buffer.from(String(s).replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8');\n  } catch (e) { return ''; }\n}\n\n// Le mail multipart annidano le parti: vanno percorse in ricorsione.\nfunction raccogli(part, out) {\n  if (!part) return;\n  const t = part.mimeType || '';\n  if (t === 'text/plain' && part.body?.data) out.plain.push(b64(part.body.data));\n  if (t === 'text/html'  && part.body?.data) out.html.push(b64(part.body.data));\n  (part.parts || []).forEach(p => raccogli(p, out));\n}\n\n// Prova nell'ordine: text gia' pronto, html gia' pronto, payload da decodificare.\nlet corpo = m.text || '';\n\nif (!corpo && m.html) corpo = String(m.html).replace(/<[^>]+>/g, ' ');\n\nif (!corpo && m.payload) {\n  const out = { plain: [], html: [] };\n  raccogli(m.payload, out);\n  if (m.payload.body?.data) out.plain.push(b64(m.payload.body.data));\n  corpo = out.plain.join('\\n') || out.html.join('\\n').replace(/<[^>]+>/g, ' ');\n}\n\nif (!corpo) corpo = m.snippet || '';\n\n// Il mittente arriva in forme diverse a seconda di Simplify.\nconst intestazioni = m.payload?.headers || [];\nconst h = (nome) => intestazioni.find(x =>\n  String(x.name).toLowerCase() === nome)?.value || '';\n\nconst fromRaw = m.from?.value?.[0]?.address || m.from?.text || m.From || h('from');\nconst from = String(fromRaw).match(/<(.+?)>/)?.[1] || String(fromRaw);\n\nreturn { \n  json: { \n    fonte: 'gmail', \n    id_esterno: m.id, \n    mittente: String(from).toLowerCase().trim(), \n    oggetto: m.subject || m.Subject || h('subject') || '', \n    testo: corpo.replace(/\\s+/g, ' ').trim().slice(0, 4000), \n    data: m.date || h('date') || m.internalDate || new Date().toISOString(), }, \n  binary: $input.item.binary, \n}; "
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
