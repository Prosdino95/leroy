{
  "name": "Leroy_Outlook",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Solo questi mittenti proseguono. Il filtro sta qui apposta:\n// tutto il resto non lascia mai la tua casella.\nconst MITTENTI = [\n  'octopus', 'intesasanpaolo', 'revolut',\n  'enel', 'eni', 'a2a', 'hera',\n  'vodafone', 'tim.it', 'iliad', 'windtre','paypal', 'satispay'\n];\n\nfunction pulisci(html) {\n  return String(html || '')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nreturn $input.all()\n  .map(i => i.json)\n  .filter(m => {\n    const from = (m.from?.emailAddress?.address\n      || m.sender?.emailAddress?.address || '').toLowerCase();\n    return from && MITTENTI.some(s => from.includes(s));\n  })\n  .map(m => {\n    const from = (m.from?.emailAddress?.address\n      || m.sender?.emailAddress?.address || '').toLowerCase().trim();\n    return { json: {\n      fonte: 'outlook',\n      id_esterno: m.id,\n      mittente: from,\n      oggetto: m.subject || '',\n      testo: (pulisci(m.body?.content) || m.bodyPreview || '').slice(0, 4000),\n      data: m.receivedDateTime || new Date().toISOString(),\n      ha_allegati: !!m.hasAttachments,\n    }};\n  });"
      },
