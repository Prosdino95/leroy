{
  "name": "Attese non avverate",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const CHAT_ID = 369010791;\nconst GRAZIA = 3;      // giorni di tolleranza dopo la scadenza\nconst MAX = 5;         // non sommergere di messaggi\n\nconst oggi = new Date();\nconst scadute = $('Leggi Transazioni').all().map(i => i.json)\n  .filter(r => r.data_evento)\n  .filter(r => (oggi - new Date(r.data_evento)) / 86400000 > GRAZIA)\n  .sort((a, b) => String(a.data_evento).localeCompare(String(b.data_evento)))\n  .slice(0, MAX);\n\n\nif (!scadute.length) return [];\n\nreturn scadute.map(r => {\n  const g = String(r.data_evento).slice(8, 10) + '/' + String(r.data_evento).slice(5, 7);\n  const eti = r.esercente || r.note || r.categoria;\n  return { json: {\n      text: '⏳ Addebito non rilevato\\n' +\n            String(r.importo).replace('.', ',') + ' €  ' + eti +\n            '\\nera previsto per il ' + g,\n        inline_keyboard: [\n        { text: 'Registra', callback_data: 'att|' + r.hash_dedup + '|reg' },\n        { text: 'Annulla',  callback_data: 'att|' + r.hash_dedup + '|ann' },\n      ],\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
        0
      ],
