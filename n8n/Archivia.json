    {
      "parameters": {
        "jsCode": "// La domenica (ora di Roma) si riscrivono tutte le righe, gli altri giorni\n// soltanto quelle modificate negli ultimi due giorni: due giorni e non uno\n// perche' una notte saltata non lasci buchi.\nconst adesso = new Date();\nconst giorno = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Rome', weekday: 'short' }).format(adesso);\nconst completo = giorno === 'Sun';\nconst da = new Date(adesso.getTime() - 2 * 86400000).toISOString();\nreturn [{ json: { completo, da } }];"
      },
      "id": "38487dc2-5349-4114-985f-d791793887dc",
      "name": "Tipo di backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "// Lo svuotamento restituisce il proprio esito: le righe da scrivere sono\n// quelle lette prima. Un nodo letto a vuoto non ha 'id' e viene scartato.\nreturn $('Leggi Regole').all().filter(i => i.json.id !== undefined);"
      },
      "id": "35974ff2-f202-446c-a8d8-abb42d51eba4",
      "name": "Rilancia Regole",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "return $('Leggi Log').all().filter(i => i.json.id !== undefined);"
      },
      "id": "90637bb3-1691-432c-a5aa-6fb72a039d37",
