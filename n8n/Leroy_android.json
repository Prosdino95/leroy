    {
      "parameters": {
        "jsCode": "const SEP = '|#|';   // deve coincidere con quello nel corpo di MacroDroid\n\nconst raw = $json.body ?? $json.rawBody ?? $json;\n\nlet campi;\nif (typeof raw === 'string') {\n  campi = raw.split(SEP);\n} else if (raw && typeof raw === 'object') {\n  campi = [raw.titolo, raw.testo, raw.pacchetto, raw.ts];\n} else {\n  return [];\n}\n\n// I default valgono anche se il messaggio arriva con meno campi del previsto.\nconst [titolo = '', corpo = '', pkgRaw = '', tsRaw = ''] =\n  campi.map(v => String(v ?? '').trim());\n\nconst pkg = pkgRaw.toLowerCase();\nconst testo = [titolo, corpo].filter(Boolean).join(' — ');\n\n// Prova di MacroDroid: i segnaposto non sono stati sostituiti.\nif (/\\{[a-z_]+\\}/i.test(testo)) {\n  return [{ json: { PROVA: true, ricevuto: testo } }];\n}\n\nconst RE_IMPORTO = /(?:€|\\beuro?\\b)\\s*\\d[\\d.,]*|\\d[\\d.,]*\\s*(?:€|\\beuro?\\b)/i;\nif (!RE_IMPORTO.test(testo)) return [];\n\nconst impronta = (testo + '|' + pkg).replace(/\\s+/g, '').slice(0, 120);\n\nlet ts = Number(tsRaw);\nif (!ts || isNaN(ts)) ts = Date.now();\nif (ts < 1e12) ts = ts * 1000;\n\nreturn [{ json: {\n  fonte: 'push',\n  id_esterno: 'push_' + impronta,\n  mittente: pkg || 'push',\n  oggetto: titolo,\n  testo,\n  data: new Date(ts).toISOString(),\n}}];"
      },
