      "id": "e125ef8b-2b33-4a9b-83ca-6871311558fc",
      "name": "Leggi recenti",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1408,
        368
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const NL = String.fromCharCode(10);\nconst c = $('Valida').first().json;\nconst F = c.cfg.finestre;\nconst nuova = c.riga;\nconst avviso = c.avviso || '';\nconst modo = c.modo;\n\n// Le tre letture si sovrappongono: si toglie il doppione per id.\nconst visti = {};\nconst esistenti = [\n  ...$('Cerca hash').all(),\n  ...$('Leggi attese').all(),\n  ...$('Leggi recenti').all(),\n].map(i => i.json).filter(r => {\n  if (!r || r.id === undefined || visti[r.id]) return false;\n  visti[r.id] = true;\n  return true;\n});\n\nconst minuti = (a, b) =>\n  Math.abs(new Date(a).getTime() - new Date(b).getTime()) / 60000;\nconst giorni = (a, b) =>\n  Math.abs(new Date(a).getTime() - new Date(b).getTime()) / 86400000;\nconst eImporto = String(nuova.importo).replace('.', ',');\nconst gg = (d) => String(d).slice(8, 10) + '/' + String(d).slice(5, 7);\nconst rispondi = (o) => [{ json: { riga: nuova, avviso, modo, motivo: '', testo: '', ...o } }];\n\n// 1) Lo stesso messaggio e' gia' stato scritto (vale per ogni modo).\nif (esistenti.some(r => String(r.hash_dedup) === nuova.hash_dedup)) {\n  return rispondi({ esito: 'scarta', motivo: 'gia processata' });\n}\n\n// 2) Inserimento diretto (Telegram, app): l'utente ha deciso lui, si scrive\n//    sempre. Si segnala soltanto se esiste una riga molto simile.\nif (modo === 'diretto') {\n  const sospetto = esistenti.some(r =>\n    String(r.stato) !== 'eliminata' &&\n    String(r.fonte) !== 'app' &&\n    Number(r.importo) === Number(nuova.importo) &&\n    String(r.conto) === String(nuova.conto) &&\n    r.data_inserimento &&\n    minuti(r.data_inserimento, nuova.data_inserimento) <= 360);\n  return rispondi({ esito: 'scrivi', duplicato_sospetto: sospetto });\n}\n\n// 3) La nuova riga e' un ANNUNCIO: l'unico rischio e' il sollecito, cioe'\n//    una seconda mail che riannuncia lo stesso addebito.\nif (nuova.stato === 'attesa') {\n  const giaAttesa = esistenti.find(r =>\n    String(r.stato) === 'attesa' &&\n    Math.abs(Number(r.importo) - Number(nuova.importo)) <= F.toll_importo &&\n    r.data_evento &&\n    giorni(r.data_evento, nuova.data_evento) <= F.attesa_gg);\n\n  if (giaAttesa) {\n    return rispondi({ esito: 'scarta', motivo: 'attesa gia registrata per il ' + String(giaAttesa.data_evento) });\n  }\n  return rispondi({\n    esito: 'scrivi',\n    testo: 'Addebito previsto' + NL +\n      eImporto + ' \\u20ac  ' + nuova.categoria +\n      (nuova.esercente ? NL + nuova.esercente : '') +\n      NL + 'atteso per il ' + gg(nuova.data_evento),\n  });\n}\n\n// 4) Addebito reale: prima i duplicati. Attese ed eliminate non partecipano.\nconst confrontabili = esistenti.filter(r =>\n  !['attesa', 'eliminata'].includes(String(r.stato)) &&\n  Number(r.importo) === Number(nuova.importo) &&\n  String(r.conto) === String(nuova.conto) &&\n  r.data_inserimento);\n\nconst daAltraFonte = confrontabili.find(r =>\n  String(r.fonte) !== String(nuova.fonte) &&\n  minuti(r.data_inserimento, nuova.data_inserimento) <= F.altra_fonte_ore * 60);\n\nconst stessaFonte = confrontabili.find(r =>\n  String(r.fonte) === String(nuova.fonte) &&\n  minuti(r.data_inserimento, nuova.data_inserimento) <= F.stessa_fonte_min);\n\nconst gemello = daAltraFonte || stessaFonte;\nif (gemello) {\n  return rispondi({\n    esito: 'scarta',\n    motivo: 'duplicato di ' + gemello.fonte + ' delle ' + String(gemello.data_inserimento).slice(11, 16),\n  });\n}\n\n// 5) Chiude un'attesa registrata in precedenza?\nconst candidate = esistenti\n  .filter(r =>\n    String(r.stato) === 'attesa' &&\n    Math.abs(Number(r.importo) - Number(nuova.importo)) <= F.toll_importo &&\n    r.data_evento &&\n    giorni(r.data_evento, nuova.data_evento) <= F.attesa_gg)\n  .sort((a, b) =>\n    giorni(a.data_evento, nuova.data_evento) - giorni(b.data_evento, nuova.data_evento));\n\nif (candidate.length) {\n  const att = candidate[0];\n  return rispondi({\n    esito: 'riconcilia',\n    chiave: String(att.hash_dedup),\n    testo: '\\u2713 Addebito previsto concluso' + NL +\n      eImporto + ' \\u20ac  ' + att.categoria +\n      (att.esercente ? NL + att.esercente : '') +\n      NL + 'atteso per il ' + gg(att.data_evento) +\n      (candidate.length > 1 ? NL + '\\u26a0 ' + candidate.length + ' attese compatibili' : ''),\n  });\n}\n\n// 6) Nessuna delle precedenti: e' una spesa nuova.\nconst segno = nuova.tipo === 'entrata' ? '+' : '\\u2212';\nreturn rispondi({\n  esito: 'scrivi',\n  testo: (nuova.stato === 'da_verificare' ? '\\u26a0 Importo da verificare' + NL : '') +\n    segno + ' ' + eImporto + ' \\u20ac  ' + nuova.categoria +\n    (nuova.esercente ? NL + nuova.esercente : '') +\n    NL + nuova.conto + '  (da ' + nuova.fonte + ')' +\n    (avviso ? NL + avviso : ''),\n});"
      },
