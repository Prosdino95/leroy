        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json.riga || {};\nconst errori = [];\nif (!(Number(r.importo) > 0)) errori.push('importo non valido');\nif (!r.hash_dedup) errori.push('hash mancante');\nif (!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(String(r.data_evento || ''))) errori.push('data_evento non ISO');\nreturn { json: { ...$json, modo: $json.modo === 'diretto' ? 'diretto' : 'pipeline', errori } };"
      },
