<?xml version="1.0" encoding="utf-8"?>
<!-- Nessun dato dell'app esce dal telefono: né backup cloud né trasferimento
     a un nuovo dispositivo. Lo storage della WebView contiene token e
     credenziali Cloudflare Access. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
