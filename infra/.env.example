# Leroy — variabili d'ambiente
#
# Copia questo file in .env nella stessa cartella e compila i valori.
# Il file .env NON va mai committato: è escluso dal .gitignore.
#
#   cp .env.example .env
#
# Genera i due segreti con:
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"
#   echo "N8N_ENCRYPTION_KEY=$(openssl rand -hex 32)"


# Dominio che risolve sull'IP pubblico del server.
# Deve già risolvere correttamente PRIMA del primo avvio: se il DNS non è
# pronto, Caddy fallisce la verifica e consuma quota sui limiti di
# Let's Encrypt, che blocca i tentativi ripetuti per ore.
DOMINIO=esempio.duckdns.org

# Indirizzo usato per l'account Let's Encrypt (avvisi di scadenza).
EMAIL=tua@email.it

# Password del database PostgreSQL.
# ATTENZIONE: viene usata solo alla PRIMA inizializzazione del volume.
# Cambiarla dopo non aggiorna il database, e n8n non riuscirà più ad
# autenticarsi. Per cambiarla davvero serve intervenire su Postgres.
POSTGRES_PASSWORD=

# Chiave con cui n8n cifra le credenziali salvate.
# Conservane una copia in un password manager, FUORI dal server: senza questa
# chiave un backup del database è integro ma le credenziali sono illeggibili,
# e vanno tutte ricreate a mano.
# Non cambiarla mai dopo il primo avvio.
N8N_ENCRYPTION_KEY=
